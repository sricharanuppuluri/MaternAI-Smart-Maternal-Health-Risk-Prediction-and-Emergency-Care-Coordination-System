# ==============================================================================
# MaternAI Environment Configuration Template (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - NEVER commit .env to version control.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend or public bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Client-Safe / Public Variables - prefixed with VITE_)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Backend (Server-Only Configuration)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME=MaternAI

# Supabase Server Settings (Never expose service role key to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Machine Learning Service (Phase 0 placeholders)
MODEL_PATH=ml/models/maternai_risk_model.joblib
MODEL_VERSION=v0.1.0

# Local LLM Service (Ollama / Local Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
