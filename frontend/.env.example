# ==============================================================================
# MaternAI Frontend Environment Configuration Template (.env.example)
# Copy this file to .env or .env.local for local frontend development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# - All frontend variables MUST be prefixed with VITE_.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY or any server secret here.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000/api/v1
